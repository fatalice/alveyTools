page { background: #f5f6fa; }

.page { padding: 32rpx 32rpx 200rpx; min-height: 100vh; }

.form {
  background: #fff;
  border-radius: 16rpx;
  padding: 16rpx 32rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.row {
  display: flex;
  align-items: center;
  padding: 28rpx 0;
  border-bottom: 2rpx solid #f0f0f0;
}
.row:last-child { border-bottom: none; }
.row-textarea { align-items: flex-start; }

.label {
  width: 120rpx;
  font-size: 28rpx;
  color: #666;
  flex-shrink: 0;
}

.input {
  flex: 1;
  font-size: 30rpx;
  color: #333;
}
.picker {
  flex: 1;
  font-size: 30rpx;
  color: #333;
}
.textarea {
  flex: 1;
  font-size: 30rpx;
  color: #333;
  line-height: 1.6;
  min-height: 320rpx;
}
.ph { color: #bbb; }

.footer {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 24rpx 48rpx calc(24rpx + env(safe-area-inset-bottom));
  background: #f5f6fa;
}
.save-btn {
  background: #7e57c2;
  color: #fff;
  font-size: 32rpx;
  border-radius: 12rpx;
  height: 88rpx;
  line-height: 88rpx;
}
.save-btn::after { border: none; }
.save-btn[disabled] { opacity: 0.6; }
