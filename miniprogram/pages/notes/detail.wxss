page { background: #f5f6fa; }

.page { padding: 32rpx; min-height: 100vh; }

.loading {
  display: flex;
  justify-content: center;
  padding-top: 200rpx;
  color: #999;
}

.title {
  font-size: 40rpx;
  font-weight: 700;
  color: #222;
  line-height: 1.4;
  margin-bottom: 20rpx;
}

.meta {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  font-size: 24rpx;
  color: #999;
  margin-bottom: 36rpx;
}
.pin {
  background: #7e57c2;
  color: #fff;
  border-radius: 999rpx;
  padding: 2rpx 14rpx;
  font-size: 20rpx;
}

.content {
  font-size: 30rpx;
  color: #333;
  line-height: 1.8;
  white-space: pre-wrap;
  word-break: break-word;
  background: #fff;
  border-radius: 16rpx;
  padding: 32rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.actions {
  display: flex;
  gap: 24rpx;
  margin-top: 40rpx;
}
.btn {
  flex: 1;
  font-size: 30rpx;
  border-radius: 12rpx;
  background: #7e57c2;
  color: #fff;
}
.btn::after { border: none; }
.btn-danger { background: #fff; color: #e53935; border: 2rpx solid #e53935; }
