page { background: #f5f6fa; }

.page { padding: 24rpx 32rpx 160rpx; min-height: 100vh; }

.fab {
  position: fixed;
  right: 48rpx;
  bottom: 80rpx;
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background: #7e57c2;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(126, 87, 194, 0.4);
  z-index: 99;
}
.fab-icon { font-size: 52rpx; color: #fff; font-weight: 300; }

.filter-bar {
  white-space: nowrap;
  margin-bottom: 20rpx;
}
.filter-tag {
  display: inline-block;
  padding: 12rpx 28rpx;
  margin-right: 16rpx;
  font-size: 26rpx;
  color: #666;
  background: #fff;
  border-radius: 999rpx;
}
.filter-tag.active {
  background: #7e57c2;
  color: #fff;
}

.loading, .empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding-top: 200rpx;
  color: #999;
}
.empty-emoji { font-size: 80rpx; margin-bottom: 24rpx; }
.empty-text { font-size: 28rpx; color: #999; margin-bottom: 40rpx; }
.empty-btn {
  background: #7e57c2;
  color: #fff;
  font-size: 28rpx;
  padding: 16rpx 48rpx;
  border-radius: 40rpx;
}

.note-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 28rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}
.note-card:active { background: #faf9fc; }

.note-title {
  display: flex;
  align-items: center;
  gap: 12rpx;
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 12rpx;
}
.note-title-text { flex: 1; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.pin {
  font-size: 20rpx;
  background: #7e57c2;
  color: #fff;
  border-radius: 999rpx;
  padding: 2rpx 12rpx;
  flex-shrink: 0;
}
.mine-tag {
  font-size: 20rpx;
  color: #7e57c2;
  border: 2rpx solid #7e57c2;
  border-radius: 999rpx;
  padding: 0rpx 12rpx;
  flex-shrink: 0;
}

.note-meta {
  font-size: 24rpx;
  color: #999;
  margin-bottom: 12rpx;
}

.note-preview {
  font-size: 26rpx;
  color: #666;
  line-height: 1.5;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}
