/* pages/smoke/index.wxss — 记一支（沿用 app.wxss 设计 token） */
page {
  background-color: var(--paper);
  --td-brand-color: var(--brand);
}

.app {
  padding: 0 32rpx 48rpx;
}

.back-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 64rpx;
  height: 64rpx;
}

/* ===== 顶栏 ===== */
.app-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 12rpx 4rpx 28rpx;
}

.header-left {
  display: flex;
  flex-direction: column;
}

.date-main {
  font-size: 38rpx;
  font-weight: 700;
  letter-spacing: -0.01em;
  color: var(--ink);
}

.date-sub {
  font-size: 25rpx;
  color: var(--muted);
  margin-top: 6rpx;
}

.streak {
  display: flex;
  align-items: center;
  gap: 12rpx;
  font-size: 25rpx;
  font-weight: 600;
  color: var(--ink-2);
  background: var(--surface);
  border: 1rpx solid var(--line);
  border-radius: 999rpx;
  padding: 14rpx 24rpx;
}

.streak-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: var(--brand);
  box-shadow: 0 0 0 6rpx rgba(31, 138, 76, 0.14);
}

/* ===== Hero ===== */
.hero {
  position: relative;
  background: var(--surface);
  border: 1rpx solid var(--line);
  border-radius: 36rpx;
  padding: 32rpx 32rpx 30rpx;
  overflow: hidden;
  box-shadow: 0 6rpx 24rpx rgba(26, 29, 33, 0.04);
}

.hero::before {
  content: "";
  position: absolute;
  top: -140rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 560rpx;
  height: 320rpx;
  background: radial-gradient(closest-side, rgba(184, 90, 34, 0.1), transparent 75%);
  pointer-events: none;
}

.hero-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  position: relative;
}

.hero-title {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--ink-2);
  letter-spacing: 0.06em;
}

.hero-tag {
  font-size: 24rpx;
  color: var(--amber);
  background: var(--amber-soft);
  border-radius: 999rpx;
  padding: 8rpx 20rpx;
}

.hero-tag:active {
  opacity: 0.7;
}

.stats {
  display: flex;
  margin-top: 28rpx;
  position: relative;
}

.stat {
  flex: 1;
  background: var(--surface-2);
  border-radius: 24rpx;
  padding: 20rpx 8rpx 18rpx;
  text-align: center;
  margin: 0 6rpx;
}

.stat .b {
  display: block;
  font-size: 40rpx;
  font-weight: 700;
  color: var(--ink);
  font-variant-numeric: tabular-nums;
}

.stat .s {
  display: block;
  font-size: 23rpx;
  color: var(--muted);
  margin-top: 4rpx;
}

.status-line {
  margin-top: 24rpx;
  padding: 20rpx 26rpx;
  border-radius: 24rpx;
  position: relative;
  font-size: 26rpx;
  text-align: center;
  font-weight: 500;
  transition: background 0.3s, border-color 0.3s, color 0.3s;
}

.status-line .b {
  font-weight: 700;
}

.status-line.ok {
  background: var(--brand-soft);
  border: 1rpx solid rgba(31, 138, 76, 0.2);
  color: var(--brand-deep);
}

.status-line.warn {
  background: var(--amber-soft);
  border: 1rpx solid rgba(184, 90, 34, 0.24);
  color: var(--amber);
}

.status-line.over {
  background: #fbeaea;
  border: 1rpx solid rgba(208, 59, 59, 0.24);
  color: #a83232;
}

.away {
  display: block;
  margin-top: 16rpx;
  font-size: 23rpx;
  color: var(--muted);
  text-align: center;
  position: relative;
}

/* ===== 记录入口（图标按钮）===== */
.log-btn {
  width: 132rpx;
  height: 132rpx;
  margin: 32rpx auto 0;
  border-radius: 50%;
  background: linear-gradient(135deg, #c9762f 0%, var(--amber) 100%);
  box-shadow: 0 14rpx 30rpx -12rpx rgba(184, 90, 34, 0.6);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  position: relative;
  transition: transform 0.16s ease;
}

.log-btn::after {
  content: '';
  position: absolute;
  inset: -10rpx;
  border-radius: 50%;
  border: 2rpx solid rgba(184, 90, 34, 0.22);
}

.log-btn:active {
  transform: scale(0.92);
}

.log-btn__icon {
  font-size: 52rpx;
  line-height: 1;
}

.log-btn__cap {
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.92);
  margin-top: 8rpx;
  letter-spacing: 1rpx;
}

/* ===== 区块标题 ===== */
.sec-title {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin: 0 4rpx 20rpx;
}

.sec-title .h2 {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--ink);
}

.sec-title .hint {
  font-size: 25rpx;
  color: var(--muted);
}

/* ===== 趋势图 ===== */
.chart-card {
  background: var(--surface);
  border: 1rpx solid var(--line);
  border-radius: 32rpx;
  padding: 28rpx 20rpx 12rpx;
  margin: 32rpx 0;
  box-shadow: 0 6rpx 24rpx rgba(26, 29, 33, 0.04);
}

/* ===== 今日记录 ===== */
.timeline-card {
  background: var(--surface);
  border: 1rpx solid var(--line);
  border-radius: 32rpx;
  padding: 28rpx 28rpx 12rpx;
  box-shadow: 0 6rpx 24rpx rgba(26, 29, 33, 0.04);
}

.timeline {
  padding-bottom: 8rpx;
}

.record {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 16rpx 0;
  border-bottom: 1rpx solid var(--line);
}

.record:last-child {
  border-bottom: none;
}

.rec-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: var(--amber);
  flex: none;
  box-shadow: 0 0 0 8rpx rgba(184, 90, 34, 0.12);
}

.rec-time {
  font-size: 29rpx;
  font-weight: 600;
  color: var(--ink);
  min-width: 96rpx;
  font-variant-numeric: tabular-nums;
}

.rec-reason {
  font-size: 25rpx;
  color: var(--ink-2);
  background: var(--surface-2);
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
}

.rec-del {
  margin-left: auto;
  min-width: 88rpx;
  text-align: right;
  font-size: 24rpx;
  color: var(--faint);
  flex: none;
  padding: 8rpx 0;
}

.rec-del.confirm {
  color: #a83232;
  background: #fbeaea;
  border-radius: 999rpx;
  font-size: 23rpx;
  font-weight: 600;
  padding: 8rpx 20rpx;
}

.empty {
  text-align: center;
  color: var(--muted);
  font-size: 25rpx;
  line-height: 1.9;
  padding: 56rpx 40rpx;
}

.empty text {
  display: block;
}

/* ===== 弹层内容 ===== */
.reason-grid {
  display: flex;
  flex-wrap: wrap;
  margin-bottom: 32rpx;
}

.reason {
  width: calc((100% - 20rpx) / 3);
  box-sizing: border-box;
  height: 88rpx;
  margin: 0 10rpx 20rpx 0;
  border-radius: 24rpx;
  background: var(--surface-2);
  color: var(--ink-2);
  font-size: 27rpx;
  font-weight: 500;
  display: flex;
  align-items: center;
  justify-content: center;
}

.reason.sel {
  background: var(--amber-soft);
  border: 1rpx solid rgba(184, 90, 34, 0.4);
  color: var(--amber);
  font-weight: 700;
}

.stepper {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 44rpx;
  margin: 12rpx 0 36rpx;
}

.step-btn {
  width: 88rpx;
  height: 88rpx;
  border-radius: 28rpx;
  background: var(--surface-2);
  font-size: 46rpx;
  font-weight: 500;
  color: var(--ink);
  display: flex;
  align-items: center;
  justify-content: center;
}

.step-btn.disabled {
  opacity: 0.35;
}

.stepper-num {
  font-size: 76rpx;
  font-weight: 700;
  min-width: 130rpx;
  text-align: center;
  color: var(--ink);
  font-variant-numeric: tabular-nums;
}

.sheet-btn {
  width: 100%;
  height: 100rpx;
  border-radius: 30rpx;
  font-size: 31rpx;
  font-weight: 700;
  color: #fff;
  background: linear-gradient(135deg, #c9762f 0%, var(--amber) 100%);
  box-shadow: 0 16rpx 36rpx -16rpx rgba(184, 90, 34, 0.5);
  line-height: 100rpx;
}

.sheet-note {
  display: block;
  font-size: 23rpx;
  color: var(--muted);
  text-align: center;
  margin-top: 22rpx;
  line-height: 1.6;
}
