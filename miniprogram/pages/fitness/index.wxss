/* pages/fitness/index.wxss — 体重管理（方案 B：青绿主色 + 训练项目分色） */
page {
  background-color: #f1f4f8;
  --td-brand-color: #0b9a7a;
  /* 任何子元素都不允许撑破视口宽度 */
  overflow-x: hidden;

  --fit-bg: #f1f4f8;
  --fit-surface: #ffffff;
  --fit-surface-2: #ecf1f6;
  --fit-line: #e4e9f1;
  --fit-ink: #0d1720;
  --fit-ink-2: #5e6b7a;
  --fit-ink-3: #93a0ad;
  --fit-accent: #0b9a7a;
  --fit-accent-soft: #e0f4ee;
  --fit-good: #0b9a7a;
  --fit-bad: #d9544a;
  --fit-bad-soft: #fbe9e7;
  --fit-radius: 22px;
  --fit-radius-sm: 16px;
}

.screen {
  background: linear-gradient(180deg, #f5f8fb 0%, #f1f4f8 42%);
  overflow-x: hidden;
}

.back-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 64rpx;
  height: 64rpx;
}

.views {
  padding: 0 36rpx;
  /* 内容不参与横向布局：所有子元素宽度受限于视口 */
  width: 100%;
  box-sizing: border-box;
}

.viewpad {
  height: calc(180rpx + env(safe-area-inset-bottom));
}

/* ===== 通用 ===== */
.vhead {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  padding: 12rpx 4rpx 24rpx;
}

.date {
  font-size: 22rpx;
  letter-spacing: 0.08em;
  color: var(--fit-ink-3);
  font-weight: 600;
  margin-bottom: 14rpx;
}

.ptitle {
  font-size: 54rpx;
  font-weight: 600;
  letter-spacing: -0.03em;
  line-height: 1.1;
  color: var(--fit-ink);
}

.avatar {
  width: 68rpx;
  height: 68rpx;
  border-radius: 50%;
  background: var(--fit-surface);
  border: 1rpx solid var(--fit-line);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: 700;
  color: var(--fit-ink-2);
  margin-top: 8rpx;
  box-shadow: 0 1rpx 2rpx rgba(13, 23, 32, 0.04), 0 6rpx 16rpx rgba(13, 23, 32, 0.05);
}

.card {
  background: var(--fit-surface);
  border: 1rpx solid var(--fit-line);
  border-radius: var(--fit-radius);
  padding: 32rpx;
  box-sizing: border-box;
  width: 100%;
  box-shadow: 0 1rpx 2rpx rgba(13, 23, 32, 0.04), 0 6rpx 16rpx rgba(13, 23, 32, 0.05);
  margin-bottom: 22rpx;
}

.lbl {
  font-size: 23rpx;
  color: var(--fit-ink-2);
  letter-spacing: 0.05em;
  font-weight: 600;
}

.hint {
  font-size: 22rpx;
  color: var(--fit-ink-3);
  margin-top: 18rpx;
}

.srow {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.mono {
  font-size: 25rpx;
  font-weight: 600;
  color: var(--fit-ink-2);
  font-variant-numeric: tabular-nums;
}

.muted {
  font-weight: 500;
  color: var(--fit-ink-3);
}

.shead {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 28rpx 4rpx 16rpx;
}

.shead__t {
  font-size: 25rpx;
  font-weight: 600;
  color: var(--fit-ink-2);
  letter-spacing: 0.03em;
}

.link {
  font-size: 25rpx;
  font-weight: 700;
  color: var(--fit-accent);
}

.empty {
  text-align: center;
  color: var(--fit-ink-3);
  font-size: 25rpx;
  line-height: 1.9;
  padding: 60rpx 20rpx;
}

.empty text {
  display: block;
}

/* ===== Hero ===== */
.hero {
  padding: 30rpx 32rpx 26rpx;
  background: linear-gradient(160deg, #ffffff 0%, #f7fcfa 100%);
}

.hero-main {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.hero-left {
  flex: 1;
  min-width: 0;
}

.bignum {
  display: flex;
  align-items: baseline;
  gap: 10rpx;
  margin: 8rpx 0 10rpx;
}

.bignum__v {
  font-size: 96rpx;
  font-weight: 600;
  letter-spacing: -0.045em;
  line-height: 1;
  color: var(--fit-ink);
  font-variant-numeric: tabular-nums;
}

.bignum__v--sm {
  font-size: 68rpx;
}

.bignum__u {
  font-size: 28rpx;
  color: var(--fit-ink-2);
  font-weight: 500;
}

.delta {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  font-size: 23rpx;
  font-weight: 700;
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  background: var(--fit-accent-soft);
  color: var(--fit-good);
  font-variant-numeric: tabular-nums;
}

.delta--up {
  background: var(--fit-bad-soft);
  color: var(--fit-bad);
}

/* 目标进度环 */
.ringwrap {
  position: relative;
  width: 164rpx;
  flex: 0 0 auto;
  text-align: center;
}

.ring-canvas {
  width: 164rpx;
  height: 164rpx;
  display: block;
}

.ring-center {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  height: 164rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  pointer-events: none;
}

.ring-t {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--fit-ink);
  font-variant-numeric: tabular-nums;
}

.ringcap {
  font-size: 19rpx;
  color: var(--fit-ink-3);
  margin-top: 12rpx;
  letter-spacing: 0.03em;
}

.spark {
  margin: 4rpx 0 0;
  overflow: hidden;
}

.hero-empty {
  font-size: 22rpx;
  color: var(--fit-ink-3);
  line-height: 1.6;
  padding: 6rpx 0 2rpx;
}

.hstats {
  display: flex;
  margin-top: 24rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid var(--fit-line);
}

.hstat {
  flex: 1;
  min-width: 0;
}

.hstat + .hstat {
  padding-left: 24rpx;
  border-left: 1rpx solid var(--fit-line);
}

.hstat .k {
  display: block;
  font-size: 21rpx;
  color: var(--fit-ink-3);
  letter-spacing: 0.06em;
  margin-bottom: 8rpx;
}

.hstat .v {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--fit-ink);
  font-variant-numeric: tabular-nums;
}

/* ===== 本周训练 ===== */
.week {
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
  margin-top: 28rpx;
  gap: 8rpx;
}

.wday {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-end;
  gap: 12rpx;
  height: 96rpx;
  font-size: 20rpx;
  color: var(--fit-ink-3);
  font-weight: 600;
}

.wbar {
  display: block;
  width: 40rpx;
  max-width: 100%;
  border-radius: 16rpx;
  background: var(--fit-surface-2);
  min-height: 10rpx;
}

.wday--on .wbar {
  background: linear-gradient(180deg, #12b48c, #0b9a7a);
}

.wday--on {
  color: var(--fit-ink-2);
}

.wlabel {
  font-variant-numeric: tabular-nums;
}

/* ===== 训练条目 ===== */
.list {
  padding: 12rpx 32rpx;
}

.entry {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 20rpx 0;
  border-bottom: 1rpx solid var(--fit-line);
}

.entry:last-child {
  border-bottom: none;
}

.eico {
  width: 76rpx;
  height: 76rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 34rpx;
  flex: 0 0 auto;
}

.emain {
  flex: 1;
  min-width: 0;
}

.etitle {
  font-size: 27rpx;
  font-weight: 600;
  color: var(--fit-ink);
  letter-spacing: -0.01em;
}

.esub {
  font-size: 23rpx;
  color: var(--fit-ink-3);
  margin-top: 6rpx;
  font-variant-numeric: tabular-nums;
}

.eval {
  text-align: right;
  white-space: nowrap;
}

.eval__b {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--fit-ink);
  font-variant-numeric: tabular-nums;
}

.eval__u {
  font-size: 19rpx;
  color: var(--fit-ink-3);
  margin-left: 4rpx;
  letter-spacing: 0.04em;
}

/* ===== 提示卡 ===== */
.tip {
  display: flex;
  align-items: center;
  gap: 22rpx;
  padding: 24rpx 28rpx;
  margin-top: 22rpx;
  background: linear-gradient(120deg, #f2fbf8, #f7faff);
  border: 1rpx solid #e1efea;
}

.tipico {
  width: 60rpx;
  height: 60rpx;
  border-radius: 20rpx;
  background: #fff;
  color: var(--fit-accent);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  flex: 0 0 auto;
  box-shadow: 0 1rpx 2rpx rgba(13, 23, 32, 0.04), 0 6rpx 16rpx rgba(13, 23, 32, 0.05);
}

.tipmain {
  flex: 1;
  min-width: 0;
}

.tiptitle {
  font-size: 25rpx;
  font-weight: 600;
  color: var(--fit-ink);
}

.tipsub {
  font-size: 22rpx;
  color: var(--fit-ink-3);
  margin-top: 6rpx;
}

/* ===== 表单 ===== */
.chips {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 26rpx;
}

.chip {
  padding: 16rpx 22rpx;
  border-radius: 999rpx;
  border: 1rpx solid var(--fit-line);
  background: #fff;
  color: var(--fit-ink-2);
  font-size: 24rpx;
  font-weight: 600;
  white-space: nowrap;
}

.chip--on {
  font-weight: 700;
  box-shadow: 0 8rpx 24rpx rgba(11, 154, 122, 0.24);
}

.frow {
  display: flex;
  gap: 28rpx;
  margin-top: 34rpx;
}

.fcell {
  flex: 1;
  min-width: 0;
  overflow: hidden;
}

.flabel {
  font-size: 21rpx;
  color: var(--fit-ink-3);
  letter-spacing: 0.05em;
  font-weight: 600;
}

.stepper {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 18rpx;
}

.step-btn {
  width: 62rpx;
  height: 62rpx;
  border-radius: 20rpx;
  border: 1rpx solid var(--fit-line);
  background: var(--fit-surface-2);
  color: var(--fit-ink);
  font-size: 30rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 auto;
}

.step-btn:active {
  transform: scale(0.94);
}

.stepper__v {
  font-size: 38rpx;
  font-weight: 600;
  color: var(--fit-ink);
  min-width: 84rpx;
  text-align: center;
  letter-spacing: -0.02em;
  font-variant-numeric: tabular-nums;
}

.tinput {
  width: 100%;
  background: transparent;
  border-bottom: 1rpx solid var(--fit-line);
  color: var(--fit-ink);
  font-size: 30rpx;
  padding: 18rpx 0 14rpx;
  margin-top: 6rpx;
}

.winput {
  display: flex;
  align-items: baseline;
  gap: 12rpx;
  margin-top: 4rpx;
}

/* 大字号输入框：宽度给足（避免数字被裁），高度/行高明确（避免上下截断） */
.winput__i {
  flex: 1;
  min-width: 0;
  height: 104rpx;
  line-height: 104rpx;
  padding: 0 0 10rpx;
  box-sizing: border-box;
  background: transparent;
  border-bottom: 1rpx solid var(--fit-line);
  color: var(--fit-ink);
  font-size: 80rpx;
  font-weight: 600;
  letter-spacing: -0.035em;
  font-variant-numeric: tabular-nums;
}

.winput__u {
  font-size: 28rpx;
  color: var(--fit-ink-3);
  font-weight: 600;
  flex: 0 0 auto;
}

/* placeholder 跟随大字号一起缩放 */
.winput__ph {
  color: #c2cbd6;
  font-size: 80rpx;
  font-weight: 600;
}

/* 预计消耗 */
.est {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 28rpx;
  padding: 28rpx 32rpx;
  border-radius: var(--fit-radius-sm);
  background: var(--fit-accent-soft);
  margin-bottom: 26rpx;
}

.estv {
  display: flex;
  align-items: baseline;
  gap: 8rpx;
  margin-top: 6rpx;
}

.estv__b {
  font-size: 42rpx;
  font-weight: 600;
  color: var(--fit-ink);
  font-variant-numeric: tabular-nums;
  letter-spacing: -0.02em;
}

.estv__u {
  font-size: 20rpx;
  color: var(--fit-ink-2);
  font-weight: 600;
}

.estnote {
  font-size: 20rpx;
  color: var(--fit-ink-2);
  text-align: right;
  line-height: 1.6;
  opacity: 0.85;
  white-space: pre-line;
  flex: 0 1 auto;
  min-width: 0;
  max-width: 45%;
}

.btn {
  width: 100%;
  height: 100rpx;
  border-radius: 30rpx;
  background: var(--fit-accent);
  color: #fff;
  font-size: 30rpx;
  font-weight: 700;
  text-align: center;
  line-height: 100rpx;
  letter-spacing: 0.02em;
  box-shadow: 0 16rpx 40rpx -12rpx rgba(11, 154, 122, 0.5);
}

.btn:active {
  transform: scale(0.985);
}

.btn--sm {
  height: 76rpx;
  line-height: 76rpx;
  font-size: 26rpx;
  margin-top: 24rpx;
  box-shadow: 0 10rpx 24rpx -12rpx rgba(11, 154, 122, 0.42);
}

.past {
  margin-top: 26rpx;
  text-align: center;
  font-size: 22rpx;
  color: var(--fit-ink-3);
}

.past__b {
  color: var(--fit-ink-2);
  font-weight: 600;
}

/* ===== 分段控件 ===== */
.seg {
  display: flex;
  gap: 8rpx;
  padding: 8rpx;
  background: var(--fit-surface-2);
  border-radius: 22rpx;
  margin-bottom: 22rpx;
}

.seg__i {
  flex: 1;
  min-width: 0;
  text-align: center;
  color: var(--fit-ink-3);
  font-size: 25rpx;
  font-weight: 600;
  padding: 14rpx 0;
  border-radius: 16rpx;
  overflow: hidden;
  white-space: nowrap;
}

.seg__i--on {
  background: #fff;
  color: var(--fit-ink);
  box-shadow: 0 1rpx 3rpx rgba(13, 23, 32, 0.1);
}

.crow {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  margin-bottom: 4rpx;
}

.cdelta {
  font-size: 23rpx;
  font-weight: 700;
  color: var(--fit-good);
  font-variant-numeric: tabular-nums;
  padding-bottom: 8rpx;
}

.cfoot {
  display: flex;
  justify-content: space-between;
  gap: 12rpx;
  margin-top: 16rpx;
  padding-top: 22rpx;
  border-top: 1rpx solid var(--fit-line);
  font-size: 21rpx;
  color: var(--fit-ink-3);
  font-variant-numeric: tabular-nums;
}

.cfoot text {
  flex: 1;
  min-width: 0;
  text-align: center;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* ===== 统计格 ===== */
.sgrid {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
  margin-bottom: 22rpx;
}

.scell {
  width: calc((100% - 20rpx) / 2);
  box-sizing: border-box;
  background: var(--fit-surface);
  border: 1rpx solid var(--fit-line);
  border-radius: var(--fit-radius-sm);
  padding: 26rpx 28rpx;
  box-shadow: 0 1rpx 2rpx rgba(13, 23, 32, 0.04), 0 6rpx 16rpx rgba(13, 23, 32, 0.05);
}

.scell .k {
  font-size: 21rpx;
  color: var(--fit-ink-3);
  letter-spacing: 0.05em;
  font-weight: 600;
}

.scell .v {
  font-size: 42rpx;
  font-weight: 600;
  margin-top: 12rpx;
  color: var(--fit-ink);
  font-variant-numeric: tabular-nums;
  letter-spacing: -0.025em;
}

.v__u {
  font-size: 22rpx;
  color: var(--fit-ink-3);
  font-weight: 500;
  margin-left: 6rpx;
}

/* 分布条 */
.dist {
  display: flex;
  flex-direction: column;
  gap: 22rpx;
  margin-top: 28rpx;
}

.dr {
  display: flex;
  align-items: center;
  gap: 20rpx;
  font-size: 23rpx;
  min-width: 0;
}

.dr .dn {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.dn {
  width: 100rpx;
  color: var(--fit-ink-2);
  font-weight: 600;
}

.dt {
  flex: 1;
  height: 12rpx;
  border-radius: 8rpx;
  background: var(--fit-surface-2);
  overflow: hidden;
}

.dt__i {
  height: 100%;
  border-radius: 8rpx;
}

.dv {
  width: 60rpx;
  text-align: right;
  color: var(--fit-ink-3);
  font-variant-numeric: tabular-nums;
}

/* ===== 目标 ===== */
.gtrack {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 4rpx 0 12rpx;
}

.gcell {
  text-align: center;
  flex: 0 0 auto;
  width: 156rpx;
  min-width: 0;
}

.gk {
  font-size: 20rpx;
  color: var(--fit-ink-3);
  letter-spacing: 0.06em;
}

.gv {
  font-size: 34rpx;
  font-weight: 600;
  margin-top: 8rpx;
  color: var(--fit-ink);
  font-variant-numeric: tabular-nums;
}

.gv__u {
  font-size: 20rpx;
  color: var(--fit-ink-3);
  font-weight: 500;
}

.gbar {
  flex: 1;
  height: 16rpx;
  border-radius: 10rpx;
  background: var(--fit-surface-2);
  margin: 0 24rpx;
  position: relative;
  overflow: hidden;
}

.gbar__i {
  position: absolute;
  left: 0;
  top: 0;
  bottom: 0;
  border-radius: 10rpx;
  background: linear-gradient(90deg, #12b48c, #0b9a7a);
  transition: width 0.3s;
}

.gnote {
  text-align: center;
  font-size: 22rpx;
  color: var(--fit-ink-3);
  margin-top: 28rpx;
}

.eta {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 28rpx 30rpx;
  border-radius: var(--fit-radius-sm);
  background: linear-gradient(120deg, #f2fbf8, #f6f9ff);
  border: 1rpx solid #e1efea;
  margin-bottom: 22rpx;
}

.etaico {
  width: 68rpx;
  height: 68rpx;
  border-radius: 22rpx;
  background: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--fit-accent);
  font-size: 32rpx;
  flex: 0 0 auto;
  box-shadow: 0 1rpx 2rpx rgba(13, 23, 32, 0.04), 0 6rpx 16rpx rgba(13, 23, 32, 0.05);
}

.etav {
  font-size: 34rpx;
  font-weight: 600;
  letter-spacing: -0.02em;
  color: var(--fit-ink);
  font-variant-numeric: tabular-nums;
}

.etas {
  font-size: 21rpx;
  color: var(--fit-ink-3);
  margin-top: 6rpx;
}

/* ===== 底部 Tab ===== */
.tabbar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 90;
  display: flex;
  background: rgba(255, 255, 255, 0.94);
  border-top: 1rpx solid var(--fit-line);
  padding: 16rpx 12rpx calc(22rpx + env(safe-area-inset-bottom));
}

.tabbar__i {
  flex: 1;
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
  color: var(--fit-ink-3);
  font-size: 19rpx;
  font-weight: 600;
  letter-spacing: 0.04em;
}

.tabbar__i--on {
  color: var(--fit-accent);
}

.tabbar__i--on::before {
  content: '';
  position: absolute;
  top: -18rpx;
  width: 36rpx;
  height: 4rpx;
  border-radius: 4rpx;
  background: var(--fit-accent);
}

.tabbar__ic {
  font-size: 34rpx;
  line-height: 1;
}
