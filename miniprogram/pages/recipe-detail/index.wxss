/* recipe-detail/index.wxss */
.page {
  min-height: 100vh;
  padding-bottom: 160rpx; /* 给底部操作栏让位 */
}

/* hero 大图 */
.hero {
  position: relative;
  width: 100%;
  height: 440rpx;
  background: #2a2018;
}
.hero-img {
  width: 100%;
  height: 100%;
}
.hero-scrim {
  position: absolute;
  inset: 0;
  background: linear-gradient(180deg, rgba(0, 0, 0, 0.2) 0%, rgba(0, 0, 0, 0) 30%, rgba(0, 0, 0, 0) 55%, rgba(20, 16, 10, 0.45) 100%);
}
.hero-cat {
  position: absolute;
  top: 24rpx;
  left: 32rpx;
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
  background: rgba(184, 90, 34, 0.92);
  color: #f4e4d2;
  font-size: 22rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
}

/* 标题卡（叠在 hero 下沿） */
.head {
  position: relative;
  margin: -56rpx 32rpx 0;
  background: var(--surface);
  border-radius: 32rpx;
  padding: 36rpx 36rpx 32rpx;
  box-shadow: 0 8rpx 28rpx rgba(0, 0, 0, 0.08);
  border: 1px solid var(--line);
  z-index: 2;
}
.head-title {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--ink);
  line-height: 1.25;
}
.head-meta {
  margin-top: 20rpx;
  display: flex;
  gap: 28rpx;
  flex-wrap: wrap;
  font-size: 24rpx;
  color: var(--muted);
}
.meta-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
}
.meta-ico {
  font-size: 24rpx;
}
.head-by {
  margin-top: 24rpx;
  padding-top: 24rpx;
  border-top: 1px solid var(--line);
  font-size: 22rpx;
  color: var(--faint);
}
.head-official {
  color: var(--muted);
  font-weight: 600;
}

/* 区块 */
.section {
  padding: 40rpx 32rpx 8rpx;
}
.sect-title {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--ink);
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

/* 人数调节 */
.servings {
  display: flex;
  align-items: center;
  gap: 16rpx;
}
.servings-label {
  font-size: 24rpx;
  color: var(--muted);
  font-weight: 400;
}
.stepper {
  display: flex;
  align-items: center;
  border: 1px solid var(--line);
  border-radius: 999rpx;
  overflow: hidden;
  background: var(--surface);
}
.step-btn {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  color: var(--ink);
}
.step-btn:active {
  background: var(--surface-2);
}
.step-val {
  min-width: 48rpx;
  text-align: center;
  font-size: 26rpx;
  font-weight: 600;
  color: var(--ink);
}

/* 食材 */
.ingredients {
  display: flex;
  flex-direction: column;
}
.ing {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1px solid var(--line);
  font-size: 28rpx;
}
.ing:last-child {
  border-bottom: none;
}
.ing-name {
  color: var(--ink-2);
}
.ing-qty {
  color: var(--muted);
}

/* 步骤 */
.steps {
  display: flex;
  flex-direction: column;
  gap: 32rpx;
}
.step {
  display: flex;
  gap: 24rpx;
}
.step-num {
  flex-shrink: 0;
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: var(--amber);
  color: #fff;
  font-size: 26rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
}
.step-body {
  flex: 1;
  font-size: 28rpx;
  line-height: 1.65;
  color: var(--ink-2);
  padding-top: 6rpx;
}

/* 小贴士 */
.tips {
  margin: 32rpx 32rpx 0;
  background: var(--brand-soft);
  border-radius: 24rpx;
  padding: 28rpx 32rpx;
}
.tips-t {
  font-weight: 700;
  color: var(--brand-deep);
  font-size: 26rpx;
  margin-bottom: 12rpx;
}
.tips-body {
  font-size: 26rpx;
  line-height: 1.6;
  color: var(--ink-2);
}

/* 底部操作栏 */
.actionbar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 100;
  display: flex;
  gap: 20rpx;
  padding: 20rpx 32rpx;
  padding-bottom: calc(40rpx + env(safe-area-inset-bottom));
  background: var(--surface);
  border-top: 1px solid var(--line);
}
.btn {
  flex: 1;
  height: 88rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  font-size: 30rpx;
  font-weight: 600;
}
.btn:active {
  transform: scale(0.97);
}
.btn-ico {
  font-size: 32rpx;
}
.btn-save {
  background: var(--surface-2);
  color: var(--ink);
  border: 1px solid var(--line);
}
.btn-save.liked {
  background: var(--like);
  color: #fff;
  border-color: transparent;
}
.btn-cook {
  background: var(--amber);
  color: #fff;
}

/* 加载态 */
.loading {
  padding: 200rpx 48rpx;
  text-align: center;
  color: var(--muted);
  font-size: 28rpx;
}
