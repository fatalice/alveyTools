<!--pages/exam-list/index.wxml-->
<view class="page">
  <view class="loading" wx:if="{{loading}}">加载科目中...</view>

  <view class="error" wx:elif="{{error}}">
    <text>{{error}}</text>
    <button class="retry-btn" size="mini" bindtap="loadTree">重试</button>
  </view>

  <block wx:else>
    <!-- 科目列表 -->
    <block wx:if="{{view === 'courses'}}">
      <view class="section-title">选择题库科目</view>
      <view class="exam-card" wx:for="{{courses}}" wx:key="_id" data-id="{{item._id}}" bindtap="onCourseTap">
        <view class="card-header">
          <view class="card-icon-wrap" style="background-color: {{item.color}}">
            <text class="card-icon">{{item.icon}}</text>
          </view>
          <view class="card-info">
            <view class="card-title">{{item.name}}</view>
            <view class="card-subtitle">{{item.categoryName}} · {{item.bankCount}} 个题库</view>
          </view>
          <text class="chevron">›</text>
        </view>
      </view>

      <view class="exam-card practice-card" bindtap="onPracticeTap">
        <view class="card-header">
          <view class="card-icon-wrap" style="background-color: #f3e5f5">
            <text class="card-icon">实</text>
          </view>
          <view class="card-info">
            <view class="card-title">实操练习</view>
            <view class="card-subtitle">代码与实操笔记</view>
          </view>
          <text class="chevron">›</text>
        </view>
      </view>

      <view class="empty-tip" wx:if="{{!courses.length}}">
        <text>暂无可用科目，请先在管理后台配置题库</text>
      </view>
    </block>

    <!-- 题库列表 -->
    <block wx:elif="{{view === 'banks'}}">
      <view class="back-row" bindtap="onBackCourses">‹ 返回科目</view>
      <view class="section-title">{{currentCourse.name}} · 选择题库</view>
      <view class="exam-card" wx:for="{{banks}}" wx:key="_id" data-id="{{item._id}}" bindtap="onBankTap">
        <view class="card-header">
          <view class="card-icon-wrap" style="background-color: {{item.color}}">
            <text class="card-icon">{{item.icon}}</text>
          </view>
          <view class="card-info">
            <view class="card-title">{{item.name}}</view>
            <view class="card-subtitle">{{item.description || '开始练习'}}</view>
          </view>
          <text class="chevron">›</text>
        </view>
      </view>
      <view class="empty-tip" wx:if="{{!banks.length}}">
        <text>该科目下暂无题库</text>
      </view>
    </block>
  </block>
</view>
