/* pages/exam-list/index.wxss */
page {
  background-color: #f5f6fa;
}

.page {
  padding: 24rpx 32rpx 48rpx;
  min-height: 100vh;
}

.loading,
.error {
  padding: 80rpx 24rpx;
  text-align: center;
  color: #888;
  font-size: 28rpx;
}

.retry-btn {
  margin-top: 24rpx;
}

.section-title {
  font-size: 28rpx;
  color: #666;
  margin: 8rpx 0 24rpx;
}

.back-row {
  font-size: 28rpx;
  color: #1890ff;
  margin-bottom: 8rpx;
  padding: 8rpx 0;
}

.exam-card {
  background-color: #fff;
  border-radius: 20rpx;
  padding: 36rpx 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.05);
}

.exam-card:active {
  opacity: 0.92;
}

.practice-card {
  margin-top: 16rpx;
}

.card-header {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.card-icon-wrap {
  width: 80rpx;
  height: 80rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.card-icon {
  font-size: 36rpx;
  font-weight: 600;
  color: #333;
}

.card-info {
  flex: 1;
  min-width: 0;
}

.card-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1a1a2e;
  margin-bottom: 6rpx;
}

.card-subtitle {
  font-size: 24rpx;
  color: #999;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.chevron {
  font-size: 40rpx;
  color: #ccc;
  line-height: 1;
}

.empty-tip {
  text-align: center;
  margin-top: 64rpx;
  font-size: 26rpx;
  color: #bbb;
}
