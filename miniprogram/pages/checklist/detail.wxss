.page {
  min-height: 100vh;
  background: #faf8f5;
  padding: 24rpx 28rpx;
  box-sizing: border-box;
}

/* ===== Info Card ===== */
.info-card {
  background: #fff;
  border-radius: 20rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
}

.info-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.info-label {
  font-size: 24rpx;
  color: #1a6b4a;
  font-weight: 500;
  background: #e8f5ec;
  padding: 6rpx 16rpx;
  border-radius: 8rpx;
  display: inline-block;
}

.favorite-btn {
  font-size: 24rpx;
  color: #1a6b4a;
  border: 1rpx solid #1a6b4a;
  border-radius: 24rpx;
  padding: 8rpx 20rpx;
}

.favorite-btn.active {
  background: #1a6b4a;
  color: #fff;
}

.info-title-row {
  display: flex;
  align-items: center;
  margin-bottom: 12rpx;
}

.info-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #1a1a1a;
  line-height: 1.4;
  flex: 1;
}

.title-edit-btn {
  font-size: 28rpx;
  margin-left: 16rpx;
  padding: 8rpx 12rpx;
  border-radius: 8rpx;
  background: #e8f5ec;
}

.title-edit-btn:active {
  opacity: 0.7;
}

.info-desc {
  display: block;
  font-size: 26rpx;
  color: #666;
  line-height: 1.5;
}

/* ===== Progress Card ===== */
.progress-card {
  background: #fff;
  border-radius: 20rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
}

.progress-row {
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
  margin-bottom: 20rpx;
}

.progress-left {
  display: flex;
  flex-direction: column;
}

.progress-numbers {
  display: flex;
  align-items: baseline;
}

.progress-done {
  font-size: 56rpx;
  font-weight: 700;
  color: #1a6b4a;
}

.progress-sep {
  font-size: 40rpx;
  color: #999;
  margin: 0 4rpx;
}

.progress-total {
  font-size: 40rpx;
  font-weight: 600;
  color: #1a1a1a;
}

.progress-subtitle {
  font-size: 24rpx;
  color: #999;
  margin-top: 4rpx;
}

.progress-right {
  display: flex;
  align-items: center;
}

.progress-pending {
  font-size: 24rpx;
  color: #666;
  background: #f5f5f5;
  padding: 8rpx 16rpx;
  border-radius: 8rpx;
}

.progress-bar-bg {
  height: 12rpx;
  background: #e8e8e8;
  border-radius: 6rpx;
  overflow: hidden;
}

.progress-bar-fill {
  height: 100%;
  background: #1a6b4a;
  border-radius: 6rpx;
  transition: width 0.3s ease;
}

/* ===== Quick Actions ===== */
.actions {
  display: flex;
  gap: 20rpx;
  margin-bottom: 32rpx;
}

.action-btn {
  flex: 1;
  text-align: center;
  font-size: 28rpx;
  font-weight: 500;
  padding: 22rpx 0;
  border-radius: 16rpx;
  line-height: 1;
}

.action-btn--filled {
  background: #1a6b4a;
  color: #fff;
}

.action-btn--outline {
  background: #e8f5ec;
  color: #1a6b4a;
}

.action-btn--filled:active {
  opacity: 0.85;
}

.action-btn--outline:active {
  opacity: 0.7;
}

/* ===== Group Cards ===== */
.group-card {
  background: #fff;
  border-radius: 20rpx;
  padding: 28rpx 32rpx;
  margin-bottom: 24rpx;
}

.group-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.group-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #1a1a1a;
}

.group-progress {
  font-size: 24rpx;
  color: #999;
  font-weight: 500;
}

/* ===== Item Rows ===== */
.item-row {
  display: flex;
  align-items: center;
  padding: 18rpx 0;
}

.item-row:active {
  opacity: 0.7;
}

.checkbox {
  width: 44rpx;
  height: 44rpx;
  border: 3rpx solid #d0d0d0;
  border-radius: 8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
  flex-shrink: 0;
  transition: all 0.2s ease;
}

.checkbox.checked {
  background: #1a6b4a;
  border-color: #1a6b4a;
}

.checkmark {
  color: #fff;
  font-size: 28rpx;
  font-weight: 700;
}

.item-text {
  font-size: 28rpx;
  color: #333;
  line-height: 1.5;
  flex: 1;
}

.item-text.done {
  text-decoration: line-through;
  color: #bbb;
}

/* ===== Bottom Spacer ===== */
.bottom-spacer {
  height: 60rpx;
}
