.page {
  min-height: 100vh;
  background: #faf8f5;
  padding: 0 32rpx;
  padding-top: 20rpx;
  box-sizing: border-box;
}

.brand {
  font-size: 44rpx;
  font-weight: bold;
  color: #1a6b4a;
  margin-bottom: 24rpx;
}

.hero-card {
  background: #fff;
  border-radius: 20rpx;
  padding: 40rpx;
  display: flex;
  align-items: center;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.04);
  margin-bottom: 32rpx;
}

.hero-text {
  flex: 1;
}

.hero-title {
  font-size: 34rpx;
  font-weight: bold;
  color: #1a1a2e;
  line-height: 1.4;
  margin-bottom: 12rpx;
}

.hero-desc {
  font-size: 26rpx;
  color: #666;
  line-height: 1.5;
}

.hero-icon {
  font-size: 80rpx;
  margin-left: 20rpx;
}

.new-btn {
  background: #1a6b4a;
  color: #fff;
  font-size: 32rpx;
  font-weight: bold;
  text-align: center;
  padding: 28rpx 0;
  border-radius: 16rpx;
  margin-bottom: 24rpx;
}

.new-btn:active {
  opacity: 0.85;
}

.quick-actions {
  display: flex;
  gap: 20rpx;
  margin-bottom: 28rpx;
}

.quick-item {
  flex: 1;
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  display: flex;
  align-items: center;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.04);
}

.quick-item:active {
  transform: scale(0.97);
}

.quick-icon {
  font-size: 40rpx;
  margin-right: 16rpx;
}

.quick-info {
  display: flex;
  flex-direction: column;
}

.quick-name {
  font-size: 28rpx;
  font-weight: bold;
  color: #1a1a2e;
}

.quick-desc {
  font-size: 22rpx;
  color: #999;
  margin-top: 4rpx;
}

.search-bar {
  background: #fff;
  border-radius: 16rpx;
  padding: 20rpx 28rpx;
  display: flex;
  align-items: center;
  margin-bottom: 32rpx;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.04);
}

.search-icon {
  font-size: 32rpx;
  margin-right: 16rpx;
}

.search-placeholder {
  font-size: 28rpx;
  color: #999;
}

.section {
  margin-bottom: 32rpx;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #1a1a2e;
}

.section-more {
  font-size: 26rpx;
  color: #1a6b4a;
}

.continue-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 28rpx;
  display: flex;
  align-items: center;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.04);
  margin-bottom: 16rpx;
}

.continue-card:active {
  transform: scale(0.98);
}

.continue-icon {
  font-size: 44rpx;
  margin-right: 20rpx;
  background: #e8f5ec;
  width: 72rpx;
  height: 72rpx;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.continue-info {
  flex: 1;
}

.continue-name {
  font-size: 28rpx;
  font-weight: bold;
  color: #1a1a2e;
}

.continue-meta {
  display: flex;
  align-items: center;
  margin-top: 8rpx;
}

.continue-progress {
  font-size: 24rpx;
  color: #1a6b4a;
  font-weight: bold;
  margin-right: 16rpx;
}

.continue-time {
  font-size: 22rpx;
  color: #999;
}

.continue-btn {
  background: #e8f5ec;
  color: #1a6b4a;
  font-size: 24rpx;
  font-weight: bold;
  padding: 12rpx 24rpx;
  border-radius: 8rpx;
}

.scenario-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 28rpx;
  display: flex;
  align-items: center;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.04);
  margin-bottom: 16rpx;
}

.scenario-card:active {
  transform: scale(0.98);
}

.scenario-icon {
  font-size: 40rpx;
  margin-right: 20rpx;
  background: #e8f5ec;
  width: 64rpx;
  height: 64rpx;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.scenario-info {
  flex: 1;
}

.scenario-name {
  font-size: 28rpx;
  font-weight: bold;
  color: #1a1a2e;
}

.scenario-count {
  font-size: 24rpx;
  color: #999;
  margin-top: 4rpx;
}

.scenario-arrow {
  font-size: 32rpx;
  color: #ccc;
}

.bottom-space {
  height: 140rpx;
}
