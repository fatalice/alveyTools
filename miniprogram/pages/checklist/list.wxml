<view class="page">
  <view class="list" wx:if="{{!isEmpty}}">
    <view class="list-card" wx:for="{{checklists}}" wx:key="id" data-id="{{item.id}}" bindtap="onItemTap">
      <view class="card-icon">🧳</view>
      <view class="card-body">
        <view class="card-title-row">
          <text class="card-title">{{item.title}}</text>
          <text class="card-tag">我的</text>
        </view>
        <text class="card-subtitle">{{item.subtitle}}</text>
      </view>
      <view class="card-delete" data-id="{{item.id}}" catchtap="onDelete">删除</view>
    </view>
  </view>

  <view class="empty-state" wx:else>
    <text class="empty-icon">📋</text>
    <text class="empty-text">还没有清单</text>
    <view class="empty-btn" bindtap="onFromScenario">从场景开始</view>
  </view>
</view>
