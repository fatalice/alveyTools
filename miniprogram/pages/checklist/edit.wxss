.page {
  min-height: 100vh;
  background: #faf8f5;
  padding: 24rpx 24rpx 180rpx;
  box-sizing: border-box;
}

/* Info Card */
.info-card {
  background: #fff;
  border-radius: 20rpx;
  padding: 32rpx;
  margin-bottom: 32rpx;
}

.info-label {
  font-size: 24rpx;
  color: #999;
  margin-bottom: 12rpx;
}

.title-row {
  margin-bottom: 16rpx;
}

.title-input {
  font-size: 34rpx;
  font-weight: 600;
  color: #1a1a1a;
  width: 100%;
  padding: 8rpx 0;
}

.desc-input {
  font-size: 28rpx;
  color: #666;
  width: 100%;
  padding: 8rpx 0;
}

.category-row {
  display: flex;
  align-items: center;
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #f0f0f0;
}

.category-label {
  font-size: 24rpx;
  color: #999;
  margin-right: 16rpx;
}

.category-value {
  font-size: 26rpx;
  color: #1a6b4a;
  background: #e8f5ec;
  padding: 4rpx 16rpx;
  border-radius: 8rpx;
}

/* Items Header */
.items-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 8rpx 20rpx;
}

.items-count {
  font-size: 28rpx;
  font-weight: 500;
  color: #333;
}

.restore-btn {
  padding: 8rpx 20rpx;
  border: 1rpx solid #1a6b4a;
  border-radius: 8rpx;
}

.restore-btn text {
  font-size: 22rpx;
  color: #1a6b4a;
}

/* Group Card */
.group-card {
  background: #fff;
  border-radius: 16rpx;
  margin-bottom: 24rpx;
  overflow: hidden;
}

.group-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 32rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.group-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
}

.group-menu {
  font-size: 32rpx;
  color: #999;
  padding: 8rpx 16rpx;
  letter-spacing: 2rpx;
}

/* Edit Item Row */
.edit-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 32rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.edit-item:last-of-type {
  border-bottom: none;
}

.edit-item-text {
  font-size: 28rpx;
  color: #333;
  flex: 1;
}

.delete-btn {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  color: #e53935;
  border-radius: 50%;
  flex-shrink: 0;
  margin-left: 16rpx;
}

/* Add Item Row */
.add-item-row {
  padding: 20rpx 32rpx;
  border-top: 1rpx dashed #d4e8dc;
}

.add-item-text {
  font-size: 28rpx;
  color: #1a6b4a;
}

/* Add Group */
.add-group {
  border: 2rpx dashed #1a6b4a;
  border-radius: 16rpx;
  padding: 28rpx;
  text-align: center;
  margin-bottom: 24rpx;
}

.add-group text {
  font-size: 28rpx;
  color: #1a6b4a;
}

/* Bottom Space */
.bottom-space {
  height: 40rpx;
}

/* Bottom Bar */
.bottom-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  padding: 20rpx 24rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  background: #fff;
  box-shadow: 0 -2rpx 10rpx rgba(0, 0, 0, 0.05);
  gap: 20rpx;
}

.bar-btn {
  flex: 1;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 12rpx;
  font-size: 30rpx;
  font-weight: 500;
}

.bar-btn--cancel {
  background: #e8f5ec;
  color: #1a6b4a;
}

.bar-btn--save {
  background: #1a6b4a;
  color: #fff;
}
