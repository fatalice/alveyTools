.page {
  min-height: 100vh;
  background: #faf8f5;
  padding: 20rpx 32rpx;
  box-sizing: border-box;
}

.search-bar {
  background: #fff;
  border-radius: 16rpx;
  padding: 16rpx 24rpx;
  display: flex;
  align-items: center;
  margin-bottom: 32rpx;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.04);
}

.search-icon {
  font-size: 32rpx;
  margin-right: 16rpx;
  color: #999;
}

.search-input {
  flex: 1;
  font-size: 28rpx;
  color: #1a1a2e;
}

.search-btn {
  font-size: 28rpx;
  color: #1a6b4a;
  font-weight: bold;
  padding: 0 16rpx;
}

.search-clear {
  font-size: 36rpx;
  color: #999;
  padding: 0 8rpx;
}

.result-section {
  margin-bottom: 32rpx;
}

.section-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #666;
  margin-bottom: 16rpx;
  padding-left: 8rpx;
}

.scenario-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 28rpx;
  display: flex;
  align-items: center;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.04);
  margin-bottom: 16rpx;
}

.scenario-card:active {
  transform: scale(0.98);
}

.card-icon {
  font-size: 36rpx;
  width: 72rpx;
  height: 72rpx;
  background: #e8f5ec;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
}

.card-body {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.card-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #1a1a2e;
}

.card-desc {
  font-size: 24rpx;
  color: #666;
  margin-top: 8rpx;
  line-height: 1.4;
}

.card-meta {
  font-size: 24rpx;
  color: #999;
  margin-top: 8rpx;
}

.card-arrow {
  font-size: 32rpx;
  color: #ccc;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 200rpx 0;
}

.empty-icon {
  font-size: 80rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #999;
  margin-top: 24rpx;
}

.hint-state {
  display: flex;
  justify-content: center;
  padding: 200rpx 0;
}

.hint-text {
  font-size: 28rpx;
  color: #ccc;
}
