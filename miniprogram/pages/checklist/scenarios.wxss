/* Scenarios Library Page - cream/green design */
.page {
  background: #faf8f5;
  min-height: 100vh;
  padding: 32rpx;
  padding-top: 20rpx;
  box-sizing: border-box;
}

/* Search Bar */
.search-bar {
  display: flex;
  flex-direction: row;
  align-items: center;
  background: #ffffff;
  border-radius: 16rpx;
  padding: 20rpx 28rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.search-icon {
  font-size: 32rpx;
  margin-right: 16rpx;
  color: #999;
}

.search-input {
  flex: 1;
  font-size: 28rpx;
  color: #333;
}

.search-clear {
  font-size: 36rpx;
  color: #999;
  padding: 0 12rpx;
  line-height: 1;
}

/* Category Tabs */
.category-tabs {
  display: flex;
  flex-direction: row;
  margin: 24rpx 0;
  white-space: nowrap;
}

.cat-item {
  display: inline-block;
  background: #ffffff;
  padding: 16rpx 32rpx;
  border-radius: 24rpx;
  font-size: 26rpx;
  color: #666;
  border: 1rpx solid #e0e0e0;
  margin-right: 16rpx;
  transition: all 0.2s;
}

.cat-item.active {
  background: #1a6b4a;
  color: #ffffff;
  border-color: #1a6b4a;
}

/* Scenario Cards */
.scenario-list {
  display: flex;
  flex-direction: column;
}

.scenario-card {
  display: flex;
  flex-direction: row;
  align-items: center;
  background: #ffffff;
  border-radius: 16rpx;
  padding: 28rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
  margin-bottom: 16rpx;
}

.scenario-icon {
  width: 80rpx;
  height: 80rpx;
  background: #e8f5ec;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  flex-shrink: 0;
}

.scenario-info {
  flex: 1;
  margin-left: 24rpx;
  overflow: hidden;
}

.scenario-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #1a1a2e;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.scenario-desc {
  font-size: 24rpx;
  color: #666;
  margin-top: 8rpx;
  line-height: 1.4;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.scenario-meta {
  font-size: 22rpx;
  color: #999;
  margin-top: 12rpx;
}

.scenario-arrow {
  font-size: 32rpx;
  color: #ccc;
  margin-left: 16rpx;
  flex-shrink: 0;
}

/* Empty State */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 0;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 16rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #999;
}

/* Bottom Space for Tabbar */
.bottom-space {
  height: 140rpx;
}
