.sheet-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(26, 29, 33, 0.42);
  z-index: 90;
  animation: sheet-mask-in 0.22s ease;
}

@keyframes sheet-mask-in {
  from {
    opacity: 0;
  }
  to {
    opacity: 1;
  }
}

.sheet {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 91;
  background: #ffffff;
  border-radius: 36rpx 36rpx 0 0;
  padding: 16rpx 32rpx calc(40rpx + env(safe-area-inset-bottom));
  animation: sheet-slide-up 0.28s cubic-bezier(0.22, 0.9, 0.3, 1);
  box-shadow: 0 -12rpx 40rpx rgba(26, 29, 33, 0.12);
}

@keyframes sheet-slide-up {
  from {
    transform: translateY(102%);
  }
  to {
    transform: translateY(0);
  }
}

.grab {
  width: 72rpx;
  height: 8rpx;
  border-radius: 999rpx;
  background: #e4e4dd;
  margin: 0 auto 28rpx;
}

.sheet-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #1a1d21;
  text-align: center;
}

.sheet-sub {
  font-size: 25rpx;
  color: #868a86;
  text-align: center;
  margin-top: 10rpx;
  line-height: 1.6;
}
