/* components/login-sheet/index.wxss — 登录弹层（居中，避开底部 tabBar 区域）
   颜色用具体值：组件样式隔离下 CSS 变量可能取不到 */
.mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 200;
  background: rgba(26, 29, 33, 0.45);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 56rpx;
  animation: login-mask-in 0.2s ease;
}

@keyframes login-mask-in {
  from {
    opacity: 0;
  }
  to {
    opacity: 1;
  }
}

.sheet {
  width: 100%;
  max-width: 620rpx;
  box-sizing: border-box;
  background: #ffffff;
  border-radius: 32rpx;
  padding: 44rpx 32rpx 36rpx;
  animation: login-sheet-in 0.24s cubic-bezier(0.22, 0.9, 0.3, 1);
  box-shadow: 0 20rpx 60rpx rgba(26, 29, 33, 0.2);
}

@keyframes login-sheet-in {
  from {
    opacity: 0;
    transform: scale(0.94);
  }
  to {
    opacity: 1;
    transform: scale(1);
  }
}

.sheet-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #1a1d21;
  text-align: center;
  margin-bottom: 36rpx;
}

.avatar-row {
  display: flex;
  justify-content: center;
  margin-bottom: 32rpx;
}

.avatar-btn {
  background: transparent;
  padding: 0;
  margin: 0;
  border: none;
  display: flex;
  flex-direction: column;
  align-items: center;
  line-height: 1;
}

.avatar-btn::after {
  border: none;
}

.avatar-tip {
  font-size: 24rpx;
  color: #868a86;
  margin-top: 16rpx;
}

.nick-row {
  display: flex;
  align-items: center;
  padding: 24rpx 16rpx;
  border-bottom: 1rpx solid #e4e4dd;
  margin-bottom: 32rpx;
}

.nick-label {
  width: 100rpx;
  font-size: 30rpx;
  color: #1a1d21;
}

.nick-input {
  flex: 1;
  font-size: 30rpx;
  color: #1a1d21;
}

.actions {
  display: flex;
  gap: 24rpx;
}

.btn {
  flex: 1;
  height: 88rpx;
  border-radius: 999rpx;
  text-align: center;
  line-height: 88rpx;
  font-size: 30rpx;
}

.btn--ghost {
  background: #efefe9;
  color: #868a86;
}

.btn--primary {
  background: linear-gradient(135deg, #1f8a4c 0%, #156a39 100%);
  color: #ffffff;
  font-weight: 600;
  box-shadow: 0 8rpx 20rpx rgba(31, 138, 76, 0.24);
}

.btn--busy {
  opacity: 0.6;
}
